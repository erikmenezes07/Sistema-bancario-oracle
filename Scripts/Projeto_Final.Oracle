----------------------------------------------------------------
-- LIMPEZA DE OBJETOS ANTERIORES
----------------------------------------------------------------
DECLARE
    PROCEDURE dropar_objeto(p_tipo VARCHAR2, p_nome VARCHAR2) IS
    BEGIN
        EXECUTE IMMEDIATE 'DROP ' || p_tipo || ' ' || p_nome;
    EXCEPTION
        WHEN OTHERS THEN NULL;
    END;
BEGIN
    dropar_objeto('TRIGGER', 'TRG_LOG_OPERACOES');
    dropar_objeto('TRIGGER', 'TRG_VERIFICAR_SALDO');
    dropar_objeto('TRIGGER', 'TRG_CALCULAR_LIMITE_DINAMICO');
    dropar_objeto('PACKAGE', 'PKG_BANCO');
    dropar_objeto('TABLE', 'LOG_OPERACOES');
    dropar_objeto('TABLE', 'MOVIMENTACAO');
    dropar_objeto('TABLE', 'CONTA');
    dropar_objeto('TABLE', 'CLIENTE');
    dropar_objeto('SEQUENCE', 'SEQ_MOVIMENTACAO');
    dropar_objeto('SEQUENCE', 'SEQ_LOG');
    dropar_objeto('SEQUENCE', 'SEQ_CLIENTE');
    dropar_objeto('SEQUENCE', 'SEQ_CONTA');
END;
/

----------------------------------------------------------------
-- TABELA CLIENTE
----------------------------------------------------------------
CREATE TABLE CLIENTE (
    ID_CLIENTE NUMBER PRIMARY KEY,
    NOME VARCHAR2(100),
    CPF VARCHAR2(14) UNIQUE, 
    TELEFONE VARCHAR2(20),
    EMAIL VARCHAR2(100)
);

----------------------------------------------------------------
-- TABELA CONTA
----------------------------------------------------------------
CREATE TABLE CONTA (
    ID_CONTA NUMBER PRIMARY KEY,
    ID_CLIENTE NUMBER,
    TIPO_CONTA VARCHAR2(20), 
    SALDO NUMBER(10,2),
    LIMITE_ESPECIAL NUMBER(10,2) DEFAULT 0,

    CONSTRAINT FK_CLIENTE
    FOREIGN KEY (ID_CLIENTE)
    REFERENCES CLIENTE(ID_CLIENTE)
);

----------------------------------------------------------------
-- TABELA MOVIMENTACAO
----------------------------------------------------------------
CREATE TABLE MOVIMENTACAO (
    ID_MOVIMENTACAO NUMBER PRIMARY KEY,
    ID_CONTA NUMBER,
    TIPO_MOVIMENTACAO VARCHAR2(20),
    VALOR NUMBER(10,2),
    DATA_MOVIMENTACAO DATE,

    CONSTRAINT FK_CONTA_MOV
    FOREIGN KEY (ID_CONTA)
    REFERENCES CONTA(ID_CONTA)
);

----------------------------------------------------------------
-- TABELA LOG
----------------------------------------------------------------
CREATE TABLE LOG_OPERACOES (
    ID_LOG NUMBER PRIMARY KEY,
    USUARIO_BANCO VARCHAR2(100),
    OPERACAO VARCHAR2(50),
    ID_CONTA NUMBER,
    DATA_LOG DATE
);

----------------------------------------------------------------
-- SEQUENCES (Geração automática de chaves primárias)
----------------------------------------------------------------
CREATE SEQUENCE SEQ_MOVIMENTACAO START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE SEQ_LOG START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE SEQ_CLIENTE START WITH 1 INCREMENT BY 1;
CREATE SEQUENCE SEQ_CONTA START WITH 1001 INCREMENT BY 1;

----------------------------------------------------------------
-- PACKAGE SPEC (Definição das interfaces públicas)
----------------------------------------------------------------
CREATE OR REPLACE PACKAGE PKG_BANCO AS

    -- GESTÃO DE CLIENTES
    PROCEDURE CADASTRAR_CLIENTE(
        P_NOME VARCHAR2,
        P_CPF VARCHAR2,
        P_TELEFONE VARCHAR2,
        P_EMAIL VARCHAR2
    );

    PROCEDURE ATUALIZAR_CLIENTE(
        P_ID_CLIENTE NUMBER,
        P_NOME VARCHAR2,
        P_CPF VARCHAR2,
        P_TELEFONE VARCHAR2,
        P_EMAIL VARCHAR2
    );

    PROCEDURE DELETAR_CLIENTE(
        P_ID_CLIENTE NUMBER
    );

    PROCEDURE LISTAR_CLIENTES;

    PROCEDURE BUSCAR_CLIENTE_POR_ID(
        P_ID_CLIENTE NUMBER
    );

    -- CONSULTA COMPLETA UNIFICADA 
    PROCEDURE BUSCAR_CLIENTE_COMPLETO(
        P_ID_CLIENTE NUMBER
    );

    -- GESTÃO DE CONTAS
    PROCEDURE CADASTRAR_CONTA(
        P_ID_CLIENTE NUMBER,
        P_TIPO_CONTA VARCHAR2,
        P_SALDO NUMBER
    );

    PROCEDURE ATUALIZAR_CONTA(
        P_ID_CONTA NUMBER,
        P_SALDO NUMBER
    );

    PROCEDURE DELETAR_CONTA(
        P_ID_CONTA NUMBER
    );

    PROCEDURE LISTAR_CONTAS;

    PROCEDURE BUSCAR_CONTA_POR_ID(
        P_ID_CONTA NUMBER
    );

    -- OPERAÇÕES BANCÁRIAS
    PROCEDURE REALIZAR_DEPOSITO(
        P_ID_CONTA NUMBER,
        P_VALOR NUMBER
    );

    -- Realiza levantamentos de fundos (saques)
    PROCEDURE REALIZAR_SAQUE(
        P_ID_CONTA NUMBER,
        P_VALOR NUMBER
    );

    PROCEDURE TRANSFERIR(
        P_CONTA_ORIGEM NUMBER,
        P_CONTA_DESTINO NUMBER,
        P_VALOR NUMBER
    );

    FUNCTION CONSULTAR_SALDO(
        P_ID_CONTA NUMBER
    ) RETURN NUMBER;

END PKG_BANCO;
/

----------------------------------------------------------------
-- PACKAGE BODY 
----------------------------------------------------------------
CREATE OR REPLACE PACKAGE BODY PKG_BANCO AS

    ------------------------------------------------------------
    -- REGISTAR CLIENTE
    ------------------------------------------------------------
    PROCEDURE CADASTRAR_CLIENTE(
        P_NOME VARCHAR2,
        P_CPF VARCHAR2,
        P_TELEFONE VARCHAR2,
        P_EMAIL VARCHAR2
    ) IS
    BEGIN
        INSERT INTO CLIENTE (ID_CLIENTE, NOME, CPF, TELEFONE, EMAIL)
        VALUES (SEQ_CLIENTE.NEXTVAL, P_NOME, P_CPF, P_TELEFONE, P_EMAIL);
    END CADASTRAR_CLIENTE;

    ------------------------------------------------------------
    -- ATUALIZAR CLIENTE
    ------------------------------------------------------------
    PROCEDURE ATUALIZAR_CLIENTE(
        P_ID_CLIENTE NUMBER,
        P_NOME VARCHAR2,
        P_CPF VARCHAR2,
        P_TELEFONE VARCHAR2,
        P_EMAIL VARCHAR2
    ) IS
    BEGIN
        UPDATE CLIENTE
        SET NOME = P_NOME, CPF = P_CPF, TELEFONE = P_TELEFONE, EMAIL = P_EMAIL
        WHERE ID_CLIENTE = P_ID_CLIENTE;
    END ATUALIZAR_CLIENTE;

    ------------------------------------------------------------
    -- DELETAR CLIENTE
    ------------------------------------------------------------
    PROCEDURE DELETAR_CLIENTE(
        P_ID_CLIENTE NUMBER
    ) IS
    BEGIN
        DELETE FROM MOVIMENTACAO
        WHERE ID_CONTA IN (
            SELECT ID_CONTA FROM CONTA WHERE ID_CLIENTE = P_ID_CLIENTE
        );

        DELETE FROM CONTA
        WHERE ID_CLIENTE = P_ID_CLIENTE;

        DELETE FROM CLIENTE
        WHERE ID_CLIENTE = P_ID_CLIENTE;
    END DELETAR_CLIENTE;

    ------------------------------------------------------------
    -- LISTAR CLIENTES
    ------------------------------------------------------------
    PROCEDURE LISTAR_CLIENTES IS
    BEGIN
        FOR C IN (SELECT * FROM CLIENTE) LOOP
            DBMS_OUTPUT.PUT_LINE(
                'ID: ' || C.ID_CLIENTE || ' | NOME: ' || C.NOME || ' | CPF: ' || C.CPF
            );
        END LOOP;
    END LISTAR_CLIENTES;

    ------------------------------------------------------------
    -- BUSCAR CLIENTE POR ID
    ------------------------------------------------------------
    PROCEDURE BUSCAR_CLIENTE_POR_ID(
        P_ID_CLIENTE NUMBER
    ) IS
        V_NOME CLIENTE.NOME%TYPE;
        V_CPF CLIENTE.CPF%TYPE;
    BEGIN
        SELECT NOME, CPF INTO V_NOME, V_CPF
        FROM CLIENTE
        WHERE ID_CLIENTE = P_ID_CLIENTE;

        DBMS_OUTPUT.PUT_LINE('NOME: ' || V_NOME || ' | CPF: ' || V_CPF);
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            DBMS_OUTPUT.PUT_LINE('Erro: O cliente com ID ' || P_ID_CLIENTE || ' não existe.');
    END BUSCAR_CLIENTE_POR_ID;

    ------------------------------------------------------------
    -- BUSCAR CLIENTE COMPLETO
    ------------------------------------------------------------
    PROCEDURE BUSCAR_CLIENTE_COMPLETO(
        P_ID_CLIENTE NUMBER
    ) IS
        V_ENCONTRADO BOOLEAN := FALSE;
    BEGIN
        FOR DADOS IN (
            SELECT C.ID_CLIENTE, C.NOME, C.CPF, C.TELEFONE, C.EMAIL,
                   CT.ID_CONTA, CT.TIPO_CONTA, CT.SALDO, CT.LIMITE_ESPECIAL
            FROM CLIENTE C
            LEFT JOIN CONTA CT ON C.ID_CLIENTE = CT.ID_CLIENTE
            WHERE C.ID_CLIENTE = P_ID_CLIENTE
        ) LOOP
            V_ENCONTRADO := TRUE;
            DBMS_OUTPUT.PUT_LINE(
                'CLIENTE: ' || DADOS.NOME || ' (ID: ' || DADOS.ID_CLIENTE || ')' ||
                ' | CPF: ' || DADOS.CPF || ' | TEL: ' || DADOS.TELEFONE || ' | EMAIL: ' || DADOS.EMAIL
            );
            IF DADOS.ID_CONTA IS NOT NULL THEN
                DBMS_OUTPUT.PUT_LINE(
                    '   -> CONTA: ' || DADOS.ID_CONTA || 
                    ' | TIPO: ' || DADOS.TIPO_CONTA ||
                    ' | SALDO: R$ ' || TO_CHAR(DADOS.SALDO, 'FM999G990D00') ||
                    ' | LIMITE DISPONÍVEL: R$ ' || TO_CHAR(DADOS.LIMITE_ESPECIAL, 'FM999G990D00')
                );
            ELSE
                DBMS_OUTPUT.PUT_LINE('   -> Nenhuma conta associada a este cliente.');
            END IF;
        END LOOP;

        IF NOT V_ENCONTRADO THEN
            DBMS_OUTPUT.PUT_LINE('Erro: O cliente com ID ' || P_ID_CLIENTE || ' não foi encontrado.');
        END IF;
    END BUSCAR_CLIENTE_COMPLETO;

    ------------------------------------------------------------
    -- REGISTAR CONTA
    ------------------------------------------------------------
    PROCEDURE CADASTRAR_CONTA(
        P_ID_CLIENTE NUMBER,
        P_TIPO_CONTA VARCHAR2,
        P_SALDO NUMBER
    ) IS
    BEGIN
        INSERT INTO CONTA (ID_CONTA, ID_CLIENTE, TIPO_CONTA, SALDO)
        VALUES (SEQ_CONTA.NEXTVAL, P_ID_CLIENTE, UPPER(P_TIPO_CONTA), P_SALDO);
    END CADASTRAR_CONTA;

    ------------------------------------------------------------
    -- ATUALIZAR CONTA
    ------------------------------------------------------------
    PROCEDURE ATUALIZAR_CONTA(
        P_ID_CONTA NUMBER,
        P_SALDO NUMBER
    ) IS
    BEGIN
        UPDATE CONTA SET SALDO = P_SALDO WHERE ID_CONTA = P_ID_CONTA;
    END ATUALIZAR_CONTA;

    ------------------------------------------------------------
    -- DELETAR CONTA
    ------------------------------------------------------------
    PROCEDURE DELETAR_CONTA(
        P_ID_CONTA NUMBER
    ) IS
    BEGIN
        DELETE FROM MOVIMENTACAO WHERE ID_CONTA = P_ID_CONTA;
        DELETE FROM CONTA WHERE ID_CONTA = P_ID_CONTA;
    END DELETAR_CONTA;

    ------------------------------------------------------------
    -- LISTAR CONTAS 
    ------------------------------------------------------------
    PROCEDURE LISTAR_CONTAS IS
    BEGIN
        FOR C IN (SELECT * FROM CONTA) LOOP
            DBMS_OUTPUT.PUT_LINE(
                'CONTA: ' || C.ID_CONTA || 
                ' | CLIENTE: ' || C.ID_CLIENTE || 
                ' | TIPO: ' || C.TIPO_CONTA || 
                ' | SALDO: R$ ' || TO_CHAR(C.SALDO, 'FM999G990D00') || 
                ' | LIMITE: R$ ' || TO_CHAR(C.LIMITE_ESPECIAL, 'FM999G990D00')
            );
        END LOOP;
    END LISTAR_CONTAS;

    ------------------------------------------------------------
    -- BUSCAR CONTA POR ID
    ------------------------------------------------------------
    PROCEDURE BUSCAR_CONTA_POR_ID(
        P_ID_CONTA NUMBER
    ) IS
        V_TIPO CONTA.TIPO_CONTA%TYPE;
        V_SALDO NUMBER;
        V_LIMITE NUMBER;
    BEGIN
        SELECT TIPO_CONTA, SALDO, LIMITE_ESPECIAL 
        INTO V_TIPO, V_SALDO, V_LIMITE
        FROM CONTA
        WHERE ID_CONTA = P_ID_CONTA;

        DBMS_OUTPUT.PUT_LINE(
            'CONTA: ' || P_ID_CONTA || 
            ' | TIPO: ' || V_TIPO || 
            ' | SALDO: R$ ' || TO_CHAR(V_SALDO, 'FM999G990D00') || 
            ' | LIMITE: R$ ' || TO_CHAR(V_LIMITE, 'FM999G990D00')
        );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            DBMS_OUTPUT.PUT_LINE('Erro: A conta ID ' || P_ID_CONTA || ' não foi encontrada.');
    END BUSCAR_CONTA_POR_ID;

    ------------------------------------------------------------
    -- DEPÓSITO
    ------------------------------------------------------------
    PROCEDURE REALIZAR_DEPOSITO(
        P_ID_CONTA NUMBER,
        P_VALOR NUMBER
    ) IS
    BEGIN
        UPDATE CONTA SET SALDO = SALDO + P_VALOR WHERE ID_CONTA = P_ID_CONTA;

        INSERT INTO MOVIMENTACAO (ID_MOVIMENTACAO, ID_CONTA, TIPO_MOVIMENTACAO, VALOR, DATA_MOVIMENTACAO)
        VALUES (SEQ_MOVIMENTACAO.NEXTVAL, P_ID_CONTA, 'DEPOSITO', P_VALOR, SYSDATE);
    END REALIZAR_DEPOSITO;

    ------------------------------------------------------------
    -- LEVANTAMENTO
    ------------------------------------------------------------
    PROCEDURE REALIZAR_SAQUE(
        P_ID_CONTA NUMBER,
        P_VALOR NUMBER
    ) IS
    BEGIN
        UPDATE CONTA SET SALDO = SALDO - P_VALOR WHERE ID_CONTA = P_ID_CONTA;

        INSERT INTO MOVIMENTACAO (ID_MOVIMENTACAO, ID_CONTA, TIPO_MOVIMENTACAO, VALOR, DATA_MOVIMENTACAO)
        VALUES (SEQ_MOVIMENTACAO.NEXTVAL, P_ID_CONTA, 'SAQUE', P_VALOR, SYSDATE);
    END REALIZAR_SAQUE;

    ------------------------------------------------------------
    -- TRANSFERÊNCIA
    ------------------------------------------------------------
    PROCEDURE TRANSFERIR(
        P_CONTA_ORIGEM NUMBER,
        P_CONTA_DESTINO NUMBER,
        P_VALOR NUMBER
    ) IS
    BEGIN
        REALIZAR_SAQUE(P_CONTA_ORIGEM, P_VALOR);
        REALIZAR_DEPOSITO(P_CONTA_DESTINO, P_VALOR);
    END TRANSFERIR;

    ------------------------------------------------------------
    -- CONSULTAR SALDO
    ------------------------------------------------------------
    FUNCTION CONSULTAR_SALDO(
        P_ID_CONTA NUMBER
    ) RETURN NUMBER IS
        V_SALDO NUMBER;
    BEGIN
        SELECT SALDO INTO V_SALDO FROM CONTA WHERE ID_CONTA = P_ID_CONTA;
        RETURN V_SALDO;
    END CONSULTAR_SALDO;

END PKG_BANCO;
/

----------------------------------------------------------------
-- TRIGGER: CALCULAR LIMITE DINÂMICO
----------------------------------------------------------------
CREATE OR REPLACE TRIGGER TRG_CALCULAR_LIMITE_DINAMICO
BEFORE INSERT OR UPDATE OF SALDO, TIPO_CONTA ON CONTA
FOR EACH ROW
DECLARE
    V_LIMITE_CALCULADO NUMBER := 0;
BEGIN
    IF UPPER(:NEW.TIPO_CONTA) = 'POUPANCA' THEN
        :NEW.LIMITE_ESPECIAL := 0;
        
    ELSIF UPPER(:NEW.TIPO_CONTA) = 'CORRENTE' AND :NEW.SALDO >= 0 THEN
        IF :NEW.SALDO < 1500 THEN
            V_LIMITE_CALCULADO := 0;
        ELSIF :NEW.SALDO >= 1500 AND :NEW.SALDO < 2500 THEN
            V_LIMITE_CALCULADO := 500;
        ELSIF :NEW.SALDO >= 2500 THEN
            V_LIMITE_CALCULADO := 1000;
        END IF;
        
        IF V_LIMITE_CALCULADO > NVL(:OLD.LIMITE_ESPECIAL, 0) THEN
            :NEW.LIMITE_ESPECIAL := V_LIMITE_CALCULADO;
        ELSE
            :NEW.LIMITE_ESPECIAL := NVL(:OLD.LIMITE_ESPECIAL, 0);
        END IF;
    END IF;
END;
/

----------------------------------------------------------------
-- TRIGGER: VERIFICAR SALDO DISPONÍVEL
----------------------------------------------------------------
CREATE OR REPLACE TRIGGER TRG_VERIFICAR_SALDO
BEFORE UPDATE OF SALDO ON CONTA
FOR EACH ROW
BEGIN
    IF :NEW.SALDO < (:OLD.LIMITE_ESPECIAL * -1) THEN
        RAISE_APPLICATION_ERROR(
            -20002,
            'Operação recusada: O valor do débito excede o saldo disponível e o limite do cheque especial.'
        );
    END IF;
END;
/

----------------------------------------------------------------
-- TRIGGER: LOG DE OPERAÇÕES
----------------------------------------------------------------
CREATE OR REPLACE TRIGGER TRG_LOG_OPERACOES
AFTER INSERT OR UPDATE OR DELETE ON CONTA
FOR EACH ROW
BEGIN
    IF INSERTING THEN
        INSERT INTO LOG_OPERACOES (ID_LOG, USUARIO_BANCO, OPERACAO, ID_CONTA, DATA_LOG)
        VALUES (SEQ_LOG.NEXTVAL, USER, 'INSERT', :NEW.ID_CONTA, SYSDATE);
    ELSIF UPDATING THEN
        INSERT INTO LOG_OPERACOES (ID_LOG, USUARIO_BANCO, OPERACAO, ID_CONTA, DATA_LOG)
        VALUES (SEQ_LOG.NEXTVAL, USER, 'UPDATE', :NEW.ID_CONTA, SYSDATE);
    ELSIF DELETING THEN
        INSERT INTO LOG_OPERACOES (ID_LOG, USUARIO_BANCO, OPERACAO, ID_CONTA, DATA_LOG)
        VALUES (SEQ_LOG.NEXTVAL, USER, 'DELETE', :OLD.ID_CONTA, SYSDATE);
    END IF;
END;
/

----------------------------------------------------------------
-- CARGA DE TESTES INICIAL
----------------------------------------------------------------
DECLARE
    FUNCTION obter_id_cliente(p_cpf VARCHAR2) RETURN NUMBER IS
        v_id NUMBER;
    BEGIN
        SELECT ID_CLIENTE INTO v_id FROM CLIENTE WHERE CPF = p_cpf;
        RETURN v_id;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN RETURN NULL;
    END;
BEGIN
    ------------------------------------------------------------
    -- 1. Registo de Clientes de Teste
    ------------------------------------------------------------
    PKG_BANCO.CADASTRAR_CLIENTE('Erik Menezes', '123.456.789-00', '81985084008', 'erikcarlos.menezes@gmail.com');
    PKG_BANCO.CADASTRAR_CLIENTE('Maria Silva', '987.654.321-00', '81985111111', 'maria@gmail.com');
    PKG_BANCO.CADASTRAR_CLIENTE('Daniel Duarte', '154.412.544-59', '8183066814', 'danielduarteld0@gmail.com');
    PKG_BANCO.CADASTRAR_CLIENTE('Camila Vitoria', '153.510.544-50', '81985343405', 'camila06vitoria14@gmail.com');

    ------------------------------------------------------------
    -- 2. Abertura de Contas
    ------------------------------------------------------------
    PKG_BANCO.CADASTRAR_CONTA(obter_id_cliente('123.456.789-00'), 'CORRENTE', 1500); 
    PKG_BANCO.CADASTRAR_CONTA(obter_id_cliente('987.654.321-00'), 'POUPANCA', 2000);  
    PKG_BANCO.CADASTRAR_CONTA(obter_id_cliente('154.412.544-59'), 'CORRENTE', 3000);  
    PKG_BANCO.CADASTRAR_CONTA(obter_id_cliente('153.510.544-50'), 'POUPANCA', 4000); 

    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Banco de dados inicializado com sucesso com a regra da Opção B ativa!');
END;
/
