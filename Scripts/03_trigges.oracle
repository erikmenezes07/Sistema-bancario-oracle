### trigger para atualização de saldo
CREATE OR REPLACE TRIGGER TRG_ATUALIZA_SALDO
AFTER INSERT ON MOVIMENTACAO
FOR EACH ROW
BEGIN
    IF :NEW.TIPO_MOVIMENTACAO = 'CREDITO' THEN
        UPDATE CONTA SET SALDO = SALDO + :NEW.VALOR
        WHERE ID_CONTA = :NEW.ID_CONTA;
    ELSIF :NEW.TIPO_MOVIMENTACAO = 'DEBITO' THEN
        UPDATE CONTA SET SALDO = SALDO - :NEW.VALOR
        WHERE ID_CONTA = :NEW.ID_CONTA;
    END IF;
END;
/
