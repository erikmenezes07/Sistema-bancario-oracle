### Tabela Cliente

CREATE TABLE CLIENTE (
    ID_CLIENTE NUMBER PRIMARY KEY,
    NOME VARCHAR2(100) NOT NULL,
    CPF VARCHAR2(14) UNIQUE NOT NULL,
    TELEFONE VARCHAR2(20),
    EMAIL VARCHAR2(100)
);

### Tabela conta

CREATE TABLE CONTA (
    ID_CONTA NUMBER PRIMARY KEY,
    ID_CLIENTE NUMBER NOT NULL,
    TIPO_CONTA VARCHAR2(20),
    SALDO NUMBER(10,2) DEFAULT 0,

    CONSTRAINT FK_CLIENTE
    FOREIGN KEY (ID_CLIENTE)
    REFERENCES CLIENTE(ID_CLIENTE)
);

### Tabela movimentacao

CREATE TABLE MOVIMENTACAO (
    ID_MOVIMENTACAO NUMBER PRIMARY KEY,
    ID_CONTA NUMBER NOT NULL,
    TIPO_MOVIMENTACAO VARCHAR2(20),
    VALOR NUMBER(10,2),
    DATA_MOVIMENTACAO DATE,

    CONSTRAINT FK_CONTA_MOV

### Tabela usuario_admin

CREATE TABLE USUARIO_ADMIN (
    ID_ADMIN NUMBER PRIMARY KEY,
    NOME VARCHAR2(100),
    LOGIN VARCHAR2(50) UNIQUE,
    SENHA VARCHAR2(50)
);
    FOREIGN KEY (ID_CONTA)
    REFERENCES CONTA(ID_CONTA)
);
